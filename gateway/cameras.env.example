# Camera sources for the stream gateway. Copy to gateway/cameras.env (never commit it).
# One line per path: MTX_PATHS_<PATHNAME>_SOURCE. Channel N sub-stream on a Hikvision NVR is
# /Streaming/Channels/N02 (for example channel 3 -> 302); the main stream is N01.
MTX_PATHS_NVR1-CH03_SOURCE=rtsp://VIEWER_USER:PASSWORD@NVR1_IP:554/Streaming/Channels/302
