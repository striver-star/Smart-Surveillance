{$HSS_HOSTNAME} {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}
	handle /stream/* {
		uri strip_prefix /stream
		reverse_proxy gateway:8889
	}
	# Task 19: wall PC capacity test page
	handle_path /wall-test/* {
		root * /srv/wall-test
		file_server
	}
	redir /wall-test /wall-test/
	# Wall Agent builds, for self-update and installer download (built by services/wall-agent/build.sh)
	handle_path /wall-agent/* {
		root * /srv/wall-agent
		file_server
	}
	handle {
		respond "HSS platform: PoC services are running." 200
	}
}
