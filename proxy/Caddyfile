{
	# Browsers send no server name when the address is an IP, and inside Docker the proxy
	# cannot see which IP was used, so tell it which certificate to present by default.
	default_sni {$HSS_SERVER_IP}
}

{$HSS_HOSTNAME} {
	# Certificates from the proxy's own private authority (no public internet needed).
	tls internal

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}
	# Live and recorded video. Every request is checked by the API first: a signed-in person allowed to
	# watch (and written to the viewing log), or a wall screen with its key. See services/api/app/viewing.py.
	handle /stream/* {
		forward_auth api:8000 {
			uri /live/authorize
		}
		uri strip_prefix /stream
		reverse_proxy gateway:8889
	}
	# Task 19: wall PC capacity test page
	handle_path /wall-test/* {
		root * /srv/wall-test
		file_server
	}
	redir /wall-test /wall-test/
	# Wall Agent builds, for self-update and installer download (built by services/wall-agent/build.sh)
	handle_path /wall-agent/* {
		root * /srv/wall-agent
		file_server
	}
	# Wall screens (Phase 2): opened by the Wall Agent on each TV. Same rules as the console, plus
	# talking to the Wall Agent on the wall PC itself (127.0.0.1) for heartbeats.
	handle /wall/* {
		root * /srv/console
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Cache-Control "no-cache"
		}
		try_files {path} /wall/index.html
		file_server
	}
	redir /wall /wall/
	# Phone app for guards and supervisors (installs to the home screen; uses the phone's GPS when asked).
	handle /m/* {
		root * /srv/console
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			Permissions-Policy "geolocation=(self), camera=(), microphone=()"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Cache-Control "no-cache"
		}
		try_files {path} /m/index.html
		file_server
	}
	redir /m /m/
	# Web console (login, overview, live view, events, devices, walls, users, settings)
	handle {
		root * /srv/console
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}

# ZKTeco access devices call in here over plain HTTP (their push protocol; see services/api/app/zkteco.py).
# Only the /iclock/ paths, and the API only listens to devices an administrator has added. Keep port 8088
# reachable from the security VLAN only (firewall), never from the internet.
:8088 {
	handle /iclock/* {
		reverse_proxy api:8000
	}
	handle {
		respond 404
	}
}
