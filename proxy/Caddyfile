{
	# Browsers send no server name when the address is an IP, and inside Docker the proxy
	# cannot see which IP was used, so tell it which certificate to present by default.
	default_sni {$HSS_SERVER_IP}
}

{$HSS_HOSTNAME} {
	# Certificates from the proxy's own private authority (no public internet needed).
	tls internal

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}
	handle /stream/* {
		uri strip_prefix /stream
		reverse_proxy gateway:8889
	}
	# Task 19: wall PC capacity test page
	handle_path /wall-test/* {
		root * /srv/wall-test
		file_server
	}
	redir /wall-test /wall-test/
	# Wall Agent builds, for self-update and installer download (built by services/wall-agent/build.sh)
	handle_path /wall-agent/* {
		root * /srv/wall-agent
		file_server
	}
	# Web console (login, overview, live view, events, devices, walls, users, settings)
	handle {
		root * /srv/console
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}
