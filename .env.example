# Copy to .env and change every value. Never commit .env.
HSS_TZ=Africa/Lagos

POSTGRES_DB=hss
POSTGRES_USER=hss
POSTGRES_PASSWORD=change-me

# Names the HTTPS proxy answers to: localhost plus this server's LAN IP, for example
# "localhost, 10.6.83.82". Certificates come from the proxy's own private authority.
HSS_HOSTNAME=localhost

# LAN IP address of this server; wall PCs receive WebRTC video from it.
HSS_SERVER_IP=127.0.0.1

# Shared secret that AI workers use to post events. Generate with: openssl rand -hex 32
HSS_WORKER_TOKEN=change-me-too

# AI worker: model file in ./models (yolox_s.onnx, or yolox_nano.onnx for slow CPUs)
HSS_MODEL=yolox_s.onnx
# Worker camera and zone file (copy config/worker.example.json to config/worker.json)
HSS_WORKER_CONFIG_FILE=./config/worker.json

# Wall Agents use this token for heartbeats (put the same value in each wall PC's installer).
HSS_WALL_TOKEN=change-me-three
# Temporary admin token for setting wall layouts until Phase 1 adds sign-in.
HSS_ADMIN_TOKEN=change-me-four

# Notifications (task 21). WhatsApp gateway token: openssl rand -hex 32
HSS_WA_TOKEN=change-me-five
# E-mail fallback through any SMTP server (leave HSS_SMTP_HOST empty to turn off)
HSS_SMTP_HOST=
HSS_SMTP_PORT=587
HSS_SMTP_USER=
HSS_SMTP_PASSWORD=
HSS_SMTP_FROM=
HSS_SMTP_STARTTLS=true
# Push topic for alerts; use a hard-to-guess name, e.g. hss-alerts-<random>
HSS_NTFY_TOPIC=
# Daily delivery test for the one-week WhatsApp trial, local time HH:MM (empty = off)
HSS_NOTIFY_DAILY_TEST=08:05
